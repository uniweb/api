  "keywords": [
    "uniweb",
    "api",
    "session",
    "records",
    "entities",
    "foundation"
  ],
  "author": "Proximify",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniweb/api.git"
  },
  "homepage": "https://github.com/uniweb/api#readme",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@uniweb/core": "workspace:^"
  },
