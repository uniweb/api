{
  "name": "@uniweb/api",
  "version": "1.7.1",
  "description": "The client for a Uniweb site's own backend — session, records, entities — imported by a foundation the way it imports @uniweb/kit.",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./wire": "./src/wire.js",
    "./rich-text": "./src/rich-text/index.js",
    "./mock": "./src/mock/index.js",
    "./mock/node": "./src/mock/node.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "sideEffects": false,
  "keywords": [
    "uniweb",
    "api",
    "session",
    "records",
    "entities",
    "foundation"
  ],
  "author": "Proximify",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniweb/api.git"
  },
  "homepage": "https://github.com/uniweb/api#readme",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@uniweb/content-reader": "workspace:~",
    "@uniweb/core": "workspace:~",
    "@uniweb/schemas": "workspace:~"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^4.1.7"
  },
  "bin": {
    "uniweb-api-mock": "./bin/uniweb-api-mock.js"
  }
}
